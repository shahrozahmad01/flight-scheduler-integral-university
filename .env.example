# =================================
# Aircraft Network Flight Scheduler
# Environment Configuration
# Copy this file to .env and fill values
# =================================

# Database — use SQLite for local, Supabase URL for production
# DATABASE_URL=sqlite:///flight_scheduler.db
# DATABASE_URL=postgresql://postgres.[ref]:[password]@host:5432/postgres

# Flask settings
# SECRET_KEY=your-secret-key-here
# FLASK_ENV=development

# CORS — add your Vercel URL here for production
# CORS_ORIGINS=https://your-app.vercel.app

# Debug mode (development only)
# FLASK_DEBUG=True
# NOTIFICATION_SERVICE_URL=https://api.notifications.com
# ANALYTICS_TRACKING_ID=your-analytics-id

# =================================
# SECURITY SETTINGS
# =================================

# CORS allowed origins (for production)
# CORS_ORIGINS=https://your-vercel-app.vercel.app,https://yourdomain.com

# =================================
# LOGGING CONFIGURATION
# =================================

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Log file path (optional)
# LOG_FILE=logs/app.log

# =================================
# CACHE SETTINGS
# =================================

# Redis URL for caching (future enhancement)
# REDIS_URL=redis://localhost:6379

# Cache timeout in seconds
# CACHE_TIMEOUT=300

# =================================
# API CONFIGURATION
# =================================

# API rate limiting (requests per minute)
# API_RATE_LIMIT=100

# API version
# API_VERSION=v1

# =================================
# MONITORING & ANALYTICS
# =================================

# Application monitoring
# SENTRY_DSN=your-sentry-dsn-here

# Performance monitoring
# NEW_RELIC_LICENSE_KEY=your-new-relic-key

# =================================
# BACKUP & MAINTENANCE
# =================================

# Database backup frequency (hours)
# BACKUP_FREQUENCY=24

# Maintenance mode flag
# MAINTENANCE_MODE=false

# =================================
# INSTRUCTIONS
# =================================
#
# 1. Copy this file to .env
# 2. Uncomment and configure the variables you need
# 3. Never commit .env files to version control
# 4. Use different values for development and production
# 5. Generate secure random keys for production secrets
#
# For local development:
# - Use SQLite database
# - Set FLASK_ENV=development
# - Use simple SECRET_KEY
#
# For production:
# - Use Supabase PostgreSQL URL
# - Set FLASK_ENV=production
# - Use strong, random SECRET_KEY
# - Configure CORS_ORIGINS for your frontend domain